# ── Core ──────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=your_secret_key_here
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="postgresql://user:password@localhost:5432/clutterscore?schema=public"

# Base64-encoded 32-byte key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=your_base64_encoded_32_byte_key_here

# ── Polar.sh billing ──────────────────────────────────────────────────────────
POLAR_ACCESS_TOKEN=your_polar_access_token_here
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here

# One product ID per plan and interval.
NEXT_PUBLIC_PRO_TIER0_MONTHLY_PLAN_ID=your_pro_tier0_monthly_product_id
NEXT_PUBLIC_PRO_TIER0_YEARLY_PLAN_ID=your_pro_tier0_yearly_product_id
NEXT_PUBLIC_PRO_TIER1_MONTHLY_PLAN_ID=your_pro_tier1_monthly_product_id
NEXT_PUBLIC_PRO_TIER1_YEARLY_PLAN_ID=your_pro_tier1_yearly_product_id
NEXT_PUBLIC_PRO_TIER2_MONTHLY_PLAN_ID=your_pro_tier2_monthly_product_id
NEXT_PUBLIC_PRO_TIER2_YEARLY_PLAN_ID=your_pro_tier2_yearly_product_id
NEXT_PUBLIC_PRO_TIER3_MONTHLY_PLAN_ID=your_pro_tier3_monthly_product_id
NEXT_PUBLIC_PRO_TIER3_YEARLY_PLAN_ID=your_pro_tier3_yearly_product_id

# ── Background jobs and email ─────────────────────────────────────────────────
# Local development uses the Inngest dev server. Production needs these keys.
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key
RESEND_API_KEY=your_resend_api_key_here

# ── Archive storage ───────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token

# ── Integrations ──────────────────────────────────────────────────────────────
# Google is used for both sign-in and the Google Workspace connector.
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

DROPBOX_CLIENT_ID=your_dropbox_client_id_here
DROPBOX_CLIENT_SECRET=your_dropbox_client_secret_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here

NOTION_CLIENT_ID=your_notion_client_id_here
NOTION_CLIENT_SECRET=your_notion_client_secret_here
NOTION_WEBHOOK_SECRET=your_notion_webhook_secret_here

# Optional: connector implemented but disabled or hidden in the UI.
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
FIGMA_CLIENT_ID=your_figma_client_id_here
FIGMA_CLIENT_SECRET=your_figma_client_secret_here
JIRA_CLIENT_ID=your_jira_client_id_here
JIRA_CLIENT_SECRET=your_jira_client_secret_here

# Optional: Telegram notifications.
TELEGRAM_API_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=your_telegram_channel_id
